<Window x:Class="VectorCharMap.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VectorCharMap"
        mc:Ignorable="d" FontSize="20"
        Title="About" Height="289" Width="530">
    <Grid>
        <Border  Width="100" Height="100" Margin="40,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image x:Name="logo" Width="100" Height="100" Source="logo-256_256.png" />
        </Border>

        <TextBlock Margin="195,40,0,0" FontSize="36" HorizontalAlignment="Left" VerticalAlignment="Top">VectorCharMap</TextBlock>
        <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="195,83,0,0" FlowDirection="LeftToRight">
            <TextBlock x:Name="developedBy" FontSize="20" Margin="0,0,6,0">Developed by</TextBlock>
            <TextBlock FontSize="20">Mitko Nedyalkov</TextBlock>
        </WrapPanel>

        <TextBlock x:Name="unicodeLicenseText" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="14" Margin="20,0,0,54" Width="336" TextWrapping="Wrap">This application uses the Unicode Character Database to get names of characters</TextBlock>

        <StackPanel x:Name="LicenseInformationArea" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,20">
            <Label x:Name="InformationLabel" Padding="0,1,0,0" FontSize="14">Information:</Label>
            <Button x:Name="TermsOfUseButton" Style="{DynamicResource ButtonStyleLight}" Margin="4,0,2,0" Padding="8,1,8,1" FontSize="14" Click="Button_Click">Terms of use</Button>
            <Button x:Name="LicenseButton" Style="{DynamicResource ButtonStyleLight}" Margin="2,0,0,0" Padding="8,1,8,1" FontSize="14" Click="LicenseButton_Click">License</Button>
        </StackPanel>

        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" FlowDirection="LeftToRight">
            <TextBlock x:Name="versionText" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,10,0">Version:</TextBlock>
            <TextBlock x:Name="versionNumber" FontSize="20">1.0.0</TextBlock>
        </WrapPanel>
    </Grid>
</Window>
